# Dev environment Terraform variable overrides.
# 
# This file is intentionally committed as a documented example/placeholder.
# Do NOT put real secrets or environment-specific credentials here.
#
# To use this file locally:
#   - Copy it to a non-committed file such as `terraform.tfvars` or
#     `terraform.dev.tfvars`, and
#   - Fill in the appropriate values for your environment.
#
# Example (uncomment and adjust as needed):
# project_name       = "example-dev"
# environment        = "dev"
# resource_prefix    = "dev-example"
# example_flag       = true
# db_username = "postgresadmin"
# db_password = "replace-with-strong-password"
# postgres_allowed_public_ips = ["203.0.113.10"]
